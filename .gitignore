# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local data, caches, raw API dumps (may contain league-private data)
/data/
!/data/.gitkeep

# Secrets — never commit. Credentials live in the OS credential store (keyring).
.env
.env.*
.secrets/
*.secret
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Playwright MCP scratch output
.playwright-mcp/

# Personal state (local-only) — templates ship as templates/memory/ and config/*.example.toml
/memory/
/reports/
config/settings.toml
config/league.toml
config/constants.toml
config/yahoo_id_overrides.toml
/backups/
*.bak

# AI agent files generated by `fbm agent install` (machine-specific; sources live in agents/).
# Only the setup-fbm skill copies are committed so any agent can find setup in a fresh clone.
/.github/agents/
/.github/mcp.json
/.github/skills/*
!/.github/skills/setup-fbm/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/setup-fbm/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/setup-fbm/
/.mcp.json
/CLAUDE.md
/GEMINI.md
/.codex/
/.cursor/
/.gemini/
